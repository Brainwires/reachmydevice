# systemd unit for the ReachMyDevice host agent (Linux, unattended access).
#
# Install (per-user, recommended — runs in the user's graphical session so it can
# capture X11 and inject input):
#   mkdir -p ~/.config/systemd/user
#   cp rmd-host.service ~/.config/systemd/user/
#   cp rmd-host.env ~/.config/rmd/host.env   # edit tokens/URL first
#   loginctl enable-linger "$USER"                        # start at boot, survive logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now rmd-host
#
# IMPORTANT: bound to graphical-session.target, NOT default.target. GNOME imports
# WAYLAND_DISPLAY / XDG_CURRENT_DESKTOP / XDG_SESSION_TYPE (and DISPLAY/XAUTHORITY)
# into the systemd user environment only as that target is reached. Starting at boot
# would race ahead of that import: the daemon would inherit a stale env, fail to
# detect GNOME/Wayland, and fall back to a broken X11 capture path.
#
# Explicit-X-server (headless Xvfb) alternative: replace the [Install] target with
# `WantedBy=default.target`, uncomment the Environment=DISPLAY line below to point at
# your Xvfb (e.g. :99), and `loginctl enable-linger "$USER"` to start it at boot.
[Unit]
Description=ReachMyDevice host agent (remote desktop)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Config (rendezvous URL, device token, ICE servers, resolution) lives here:
EnvironmentFile=%h/.config/rmd/host.env
# For an explicit X server only (headless Xvfb); on a desktop the compositor's
# imported DISPLAY/XAUTHORITY are inherited automatically.
#Environment=DISPLAY=:99
ExecStart=%h/.local/bin/rmdd
Restart=on-failure
RestartSec=3
# Hardening (relaxed enough to allow X access):
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/rmd %h/.local/state/rmd
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
